# Copy this file to .env and fill in the values.

FRONTEND_URL=http://localhost:3000
CAMERA_INDEX=0
# Comma-separated list of origins allowed to call this API (CORS).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gmail SMTP for the contact/feedback forms.
# SMTP_PASS must be a Gmail "App Password" (Google Account -> Security ->
# 2-Step Verification -> App passwords), NOT your regular Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=
CONTACT_TO=your-email@gmail.com

# Optional in-memory monitoring. No endpoint access until a private token with
# at least 32 non-whitespace characters is configured. Never use NEXT_PUBLIC_*.
MONITORING_ENABLED=true
MONITORING_TOKEN=
MONITORING_WINDOW_SIZE=1000
MONITORING_MIN_SAMPLES=100
MONITORING_MIN_REFERENCE_SAMPLES=100
MONITORING_DRIFT_THRESHOLD=0.1
# Optional operator-reviewed production aggregate reference (JSON, read-only).
# No reference is supplied or automatically created by the application.
MONITORING_BASELINE_PATH=
